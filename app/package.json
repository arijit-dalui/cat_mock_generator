{
  "name": "cat-mock-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generates fresh CAT-style VARC/DILR/QA problem sets from a knowledge base built from past mock papers, using a local LLM.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "init-db": "node scripts/init-db.mjs",
    "build-kb": "node scripts/build-kb.mjs",
    "worker": "node scripts/worker.mjs",
    "agent": "node scripts/agent-generate.mjs",
    "submit": "node scripts/agent-submit.mjs",
    "seed-import": "node scripts/seed-import.mjs",
    "test": "node --test tests/practice.test.ts tests/llm.test.ts tests/rateLimit.test.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.3.0",
    "marked": "^18.0.4",
    "next": "14.2.5",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
