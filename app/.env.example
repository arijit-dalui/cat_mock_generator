# --- Copy this file to .env and adjust values ---

# Database (SQLite file, relative to the app folder)
DATABASE_PATH=./data/cat.db

# Session signing secret - set to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Admin account (seeded by `npm run init-db`).
# Pick a username and a strong password of your own - these defaults are
# placeholders, do NOT ship to a public deployment unchanged.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# LLM provider: "ollama" (local) or "groq" (hosted, later)
LLM_PROVIDER=ollama

# Ollama settings (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq settings (used only when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Path to the templatized extraction docs (from Step 1)
EXTRACTION_DOCS=../extraction/docs

# How many ready-to-serve sets the worker keeps pooled per section
POOL_SIZE=50

# Public URL the worker uses to call the app's internal API
APP_URL=http://localhost:3000

# Shared secret the worker uses to authenticate to the internal API
WORKER_TOKEN=change-me-to-a-long-random-string
