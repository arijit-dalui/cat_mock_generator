# actual source code), silently excluding them from every commit.
extraction/mocks/
extraction/extracted/
extraction/docs/
extraction/cache/
extraction/output/
extraction/*.log
extraction/ingestion_report.md
extraction/ingestion_report.csv
extraction/INDEX.md
extraction/manifest.json

